generator client {
  provider      = "prisma-client-js"
  output        = "../../../../node_modules/.prisma/client"
  binaryTargets = ["linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Model
 */

model Users {
  id        String  @id @default(uuid())
  avatar    String?
  firstname String
  lastname  String
  email     String  @unique
  password  String
}

model Memory {
  id          String          @id @default(uuid())
  images      String[]
  title       String
  description String
  place       String
  date        DateTime
  type        MemoryType      @default(Autres)
  friends     MemoryFriends[]
  coordinates Json
}

model Friends {
  id        String          @id @default(uuid())
  avatar    String?
  firstname String
  lastname  String
  memories  MemoryFriends[]
}

/**
 * Table de liaison pour Memory | Friends
 */
model MemoryFriends {
  memory   Memory  @relation(fields: [memoryId], references: [id])
  memoryId String
  friend   Friends @relation(fields: [friendId], references: [id])
  friendId String

  @@id([memoryId, friendId])
}

/**
 * Enum
 */

enum MemoryType {
  Vacances
  Sorties
  Evenements
  Autres
}
