  "definitions": {
    "auth.LoginDTO": {
      "type": "object",
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "example": "lucasmadranges@gmail.com"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "example": "Azertye789456\u0026!"
        }
      }
    },
    "mainType.CreateMainTypeDto": {
      "type": "object",
      "required": ["color", "name"],
      "properties": {
        "color": {
          "type": "string",
          "example": "#000000"
        },
        "name": {
          "type": "string",
          "maxLength": 25,
          "example": "Restaurant"
        }
      }
    },
    "mainType.UpdateMainTypeDto": {
      "type": "object",
      "required": ["color", "name"],
      "properties": {
        "color": {
          "type": "string",
          "example": "#000000"
        },
        "name": {
          "type": "string",
          "maxLength": 25,
          "example": "Restaurant"
        }
      }
    },
    "request.ErrorRequest": {
      "type": "object",
      "properties": {
        "explicit": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "success": {
          "type": "boolean",
          "example": false
        }
      }
    },
    "request.SuccessCreateRequest": {
      "type": "object",
      "properties": {
        "data": {},
        "success": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "request.SuccessDeleteRequest": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "example": 0
        },
        "success": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "request.SuccessGetAllRequest": {
      "type": "object",
      "properties": {
        "data": {},
        "success": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "request.SuccessGetOneRequest": {
      "type": "object",
      "properties": {
        "data": {},
        "success": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "request.SuccessUpdateRequest": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "example": 0
        },
        "success": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "subType.CreateSubTypeDto": {
      "type": "object",
      "required": ["color", "main_type_id", "name"],
      "properties": {
        "color": {
          "type": "string",
          "example": "#000000"
        },
        "main_type_id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "maxLength": 25,
          "example": "Buffet à volonté"
        }
      }
    },
    "subType.UpdateSubTypeDto": {
      "type": "object",
      "required": ["color", "name"],
      "properties": {
        "color": {
          "type": "string",
          "example": "#000000"
        },
        "name": {
          "type": "string",
          "maxLength": 25,
          "example": "Buffet à volonté"
        }
      }
    },
    "user.CreateUserDTO": {
      "type": "object",
      "required": ["email", "firstname", "lastname", "password"],
      "properties": {
        "avatar": {
          "type": "string",
          "example": "https://example.com/"
        },
        "email": {
          "type": "string",
          "example": "lucasmadranges@gmail.com"
        },
        "firstname": {
          "type": "string",
          "example": "Lucas"
        },
        "lastname": {
          "type": "string",
          "example": "Madranges"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "example": "Azertye789456\u0026!"
        },
        "role": {
          "enum": ["admin", "user"],
          "allOf": [
            {
              "$ref": "#/definitions/user.Role"
            }
          ],
          "example": "user"
        }
      }
    },
    "user.Role": {
      "type": "string",
      "enum": ["user", "admin", "user"],
      "x-enum-varnames": ["DefaultRole", "RoleAdmin", "RoleUser"]
    }
  }
